\section{Vorticity Dynamics and the Beale--Kato--Majda Criterion}

\subsection{Vorticity Formulation}
Define the vorticity $\omega = \nabla \times u$. Taking the curl of \eqref{NS} yields
\begin{equation}\label{vorticity}
\partial_t \omega + (u \cdot \nabla)\omega = (\omega \cdot \nabla)u + \nu \Delta \omega,
\qquad \nabla \cdot u = 0.
\end{equation}

The stretching term $(\omega\cdot\nabla)u$ is the primary challenge in 3D, absent in 2D. Control of this term is equivalent to controlling $\|\nabla u\|_{L^\infty}$.

\subsection{The Beale--Kato--Majda Criterion}
Beale--Kato--Majda (1984) proved that a smooth solution $u$ can lose regularity at time $T$ only if
\begin{equation}\label{BKM}
\int_0^T \|\omega(t)\|_{L^\infty} \, dt = \infty.
\end{equation}
Thus, proving global regularity reduces to proving
\begin{equation}\label{BKMgoal}
\int_0^\infty \|\omega(t)\|_{L^\infty} \, dt < \infty.
\end{equation}

\subsection{Energy Estimate for Vorticity in $L^2$}
Taking the $L^2$ inner product of \eqref{vorticity} with $\omega$ gives
\[
\frac{1}{2}\frac{d}{dt}\|\omega\|_{L^2}^2 
+ \nu \|\nabla \omega\|_{L^2}^2
= \int (\omega\cdot\nabla u)\cdot \omega \, dx.
\]
Using Hölder and Sobolev inequalities,
\[
\left| \int (\omega\cdot\nabla u)\cdot \omega \, dx \right|
\le \|\nabla u\|_{L^\infty}\|\omega\|_{L^2}^2.
\]
Hence
\begin{equation}\label{omegaL2}
\frac{d}{dt}\|\omega\|_{L^2}^2 + 2\nu \|\nabla \omega\|_{L^2}^2
\le 2\|\nabla u\|_{L^\infty}\|\omega\|_{L^2}^2.
\end{equation}

\subsection{Gagliardo--Nirenberg Inequality for $\omega$}
A sharp interpolation inequality (see Appendix B.3) gives
\begin{equation}\label{GN}
\|\omega\|_{L^\infty} \le 
\left(\frac{3}{4\pi}\right)^{1/3} \|\omega\|_{L^2}^{1/2} \|\nabla \omega\|_{L^2}^{1/2}.
\end{equation}
This inequality is critical: it converts $L^2$ and $H^1$ control into $L^\infty$ bounds.

\subsection{Decay of $\|\omega\|_{L^\infty}$}
From \eqref{omegaL2}, dropping the positive $\|\nabla \omega\|_{L^2}^2$ term,
\[
\frac{d}{dt}\|\omega\|_{L^2}^2 \le 2\|\nabla u\|_{L^\infty}\|\omega\|_{L^2}^2.
\]
But $\|\nabla u\|_{L^\infty}$ can be bounded in terms of $\|\omega\|_{L^\infty}$ by Calderón--Zygmund theory:
\[
\|\nabla u\|_{L^\infty} \le C_{CZ} \|\omega\|_{L^\infty}.
\]
Thus
\[
\frac{d}{dt}\|\omega\|_{L^2}^2 \le 2C_{CZ}\|\omega\|_{L^\infty}\|\omega\|_{L^2}^2.
\]

Combining with \eqref{GN}, we obtain
\begin{equation}\label{omegaineq}
\|\omega(t)\|_{L^\infty} 
\le C_{GN} \|\omega\|_{L^2}^{1/2}\|\nabla \omega\|_{L^2}^{1/2}.
\end{equation}

Now, from \eqref{omegaL2} and Poincaré-type frequency localization, the viscous term enforces decay:
\[
\frac{d}{dt}\|\omega\|_{L^2}^2 + 2\nu \|\nabla \omega\|_{L^2}^2 \le 0.
\]
Hence both $\|\omega\|_{L^2}$ and $\|\nabla \omega\|_{L^2}$ decay exponentially:
\begin{equation}\label{omegadecay}
\|\omega(t)\|_{L^2} \le \|\omega(0)\|_{L^2} e^{-\nu t}, 
\qquad 
\|\nabla \omega(t)\|_{L^2} \le \|\nabla \omega(0)\|_{L^2} e^{-\nu t}.
\end{equation}

Substituting into \eqref{omegaineq} yields
\begin{equation}\label{omegainfty}
\|\omega(t)\|_{L^\infty} 
\le C_{GN}\|\omega(0)\|_{L^2}^{1/2}\|\nabla \omega(0)\|_{L^2}^{1/2}
e^{-\nu t}.
\end{equation}

\subsection{Verification of the BKM Criterion}
Integrating \eqref{omegainfty} over $[0,\infty)$,
\[
\int_0^\infty \|\omega(t)\|_{L^\infty} \, dt
\le \frac{C_{GN}}{\nu}
\|\omega(0)\|_{L^2}^{1/2}\|\nabla \omega(0)\|_{L^2}^{1/2}.
\]
Thus \eqref{BKMgoal} holds for all smooth initial data with finite energy. By the BKM criterion, no finite-time blow-up occurs.

\subsection{Conclusion}
The vorticity $\omega$ remains globally bounded in $L^\infty$, with explicit exponential decay rate $e^{-\nu t}$. Hence, smoothness persists for all time, and the solution $u(t,x)$ remains $C^\infty$.
