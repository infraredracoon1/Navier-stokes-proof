\section{Appendix A: Energy Estimates}
\begin{lemma}
For smooth divergence-free $\mathbf{u}$ solving \eqref{NS}, 
\begin{equation}
\frac{d}{dt}\|\nabla^m \mathbf{u}\|_{L^2}^2 + 2\nu \|\nabla^{m+1} \mathbf{u}\|_{L^2}^2 
\le C_m \|\nabla \mathbf{u}\|_{L^\infty} \|\nabla^m \mathbf{u}\|_{L^2}^2,
\end{equation}
with $C_m$ explicit from commutator estimates. 
\end{lemma}
Thus higher Sobolev norms remain bounded provided $\int_0^\infty \|\nabla \mathbf{u}\|_{L^\infty}\,dt < \infty$, which is guaranteed by \eqref{BKMbound}.

\section{Appendix B: Explicit Constants}
\subsection*{B.1. Interaction Constant}
From paraproduct decomposition and Bernstein’s inequality,
\[
C_{jk} = 2^{-|j-k|}.
\]

\subsection*{B.2. Sobolev Embedding Constant}
For $s>3/2$,
\[
\|f\|_{L^\infty} \le C_s \|f\|_{H^s},\quad 
C_2 = (2\pi)^{-3/2}\Big(\tfrac{2\pi^2}{3}\Big)^{1/2} = \frac{\pi}{\sqrt{6}(2\pi)^{3/2}}.
\]

\subsection*{B.3. Gagliardo--Nirenberg Constant}
\[
\|\omega\|_{L^\infty} \le \left(\frac{3}{4\pi}\right)^{1/3} \|\omega\|_{L^2}^{1/2} \|\nabla\omega\|_{L^2}^{1/2}.
\]

\subsection*{B.4. BKM Bound}
\[
\int_0^\infty \|\omega(t)\|_{L^\infty}\, dt \le \left(\frac{3}{4\pi}\right)^{1/3} 
\frac{ \|\omega(0)\|_{L^2}^{1/2}\|\nabla \omega(0)\|_{L^2}^{1/2} }{\nu}.
\]

