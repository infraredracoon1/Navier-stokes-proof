\section{Energy Framework and Core Identities}

We begin by establishing energy balances and Sobolev norm evolution equations for the Navier–Stokes system \eqref{eq:NS}.  
All derivations in this section use the unmodified PDE, ensuring compatibility with Clay criteria.

\subsection{Kinetic Energy Identity ($L^2$ Norm)}
Multiply \eqref{eq:NS} by $\mathbf{u}$ and integrate over $\mathbb{R}^3$:
\[
\int_{\mathbb{R}^3} \partial_t \mathbf{u} \cdot \mathbf{u} \, dx 
+ \int_{\mathbb{R}^3} (\mathbf{u} \cdot \nabla)\mathbf{u} \cdot \mathbf{u} \, dx
= -\int_{\mathbb{R}^3} \nabla p \cdot \mathbf{u} \, dx
+ \nu \int_{\mathbb{R}^3} \Delta \mathbf{u} \cdot \mathbf{u} \, dx.
\]

\paragraph{Step 1: Time derivative.}
\[
\int \partial_t \mathbf{u}\cdot \mathbf{u} \, dx = \frac{1}{2} \frac{d}{dt}\|\mathbf{u}\|_{L^2}^2.
\]

\paragraph{Step 2: Nonlinear cancellation.}
\[
\int (\mathbf{u}\cdot \nabla)\mathbf{u}\cdot \mathbf{u} \, dx
= \frac{1}{2}\int \mathbf{u}\cdot \nabla(|\mathbf{u}|^2) \, dx
= -\frac{1}{2}\int (\nabla \cdot \mathbf{u})|\mathbf{u}|^2 \, dx = 0,
\]
since $\nabla \cdot \mathbf{u}=0$.

\paragraph{Step 3: Pressure term.}
\[
-\int \nabla p \cdot \mathbf{u} \, dx = \int p \, \nabla \cdot \mathbf{u} \, dx = 0.
\]

\paragraph{Step 4: Viscosity.}
\[
\nu \int \Delta \mathbf{u} \cdot \mathbf{u} \, dx
= -\nu \int |\nabla \mathbf{u}|^2 \, dx.
\]

\paragraph{Result.}
\begin{equation}
\frac{1}{2}\frac{d}{dt}\|\mathbf{u}\|_{L^2}^2 + \nu \|\nabla \mathbf{u}\|_{L^2}^2 = 0.
\label{eq:L2-energy}
\end{equation}
Thus the kinetic energy $E(t) = \tfrac{1}{2}\|\mathbf{u}(t)\|_{L^2}^2$ is non-increasing in time.

\subsection{Enstrophy Identity ($H^1$ Norm)}
Let $\omega = \nabla \times \mathbf{u}$ denote vorticity.  
Taking curl of \eqref{eq:NS} yields:
\begin{equation}
\partial_t \omega + (\mathbf{u}\cdot\nabla)\omega = (\omega\cdot\nabla)\mathbf{u} + \nu \Delta \omega.
\label{eq:vorticity}
\end{equation}

\paragraph{Energy identity for enstrophy.}
Multiply \eqref{eq:vorticity} by $\omega$ and integrate:
\[
\frac{1}{2}\frac{d}{dt}\|\omega\|_{L^2}^2 
= \int (\omega \cdot \nabla)\mathbf{u}\cdot \omega \, dx 
- \nu \|\nabla \omega\|_{L^2}^2.
\]

\paragraph{Bound on vortex stretching.}
By Hölder and Sobolev embeddings,
\[
\Big|\int (\omega \cdot \nabla)\mathbf{u}\cdot \omega \, dx\Big|
\leq \|\nabla \mathbf{u}\|_{L^\infty}\|\omega\|_{L^2}^2.
\]

\paragraph{Result.}
\begin{equation}
\frac{1}{2}\frac{d}{dt}\|\omega\|_{L^2}^2 
+ \nu \|\nabla \omega\|_{L^2}^2
\leq \|\nabla \mathbf{u}\|_{L^\infty}\|\omega\|_{L^2}^2.
\label{eq:enstrophy}
\end{equation}
Thus vorticity growth is driven only by $\|\nabla \mathbf{u}\|_{L^\infty}$.

\subsection{Higher Sobolev Norms ($H^s$, $s \geq 2$)}
Apply $\Lambda^s = (I-\Delta)^{s/2}$ to \eqref{eq:NS}, take $L^2$ inner product with $\Lambda^s \mathbf{u}$:
\[
\frac{1}{2}\frac{d}{dt}\|\mathbf{u}\|_{H^s}^2 + \nu \|\nabla \mathbf{u}\|_{H^s}^2
= -\langle \Lambda^s((\mathbf{u}\cdot\nabla)\mathbf{u}), \Lambda^s \mathbf{u} \rangle.
\]

\paragraph{Nonlinear estimate.}
Using Kato–Ponce commutator estimates and Sobolev embeddings:
\[
\|\Lambda^s((\mathbf{u}\cdot\nabla)\mathbf{u})\|_{L^2}
\lesssim \|\nabla \mathbf{u}\|_{L^\infty}\|\mathbf{u}\|_{H^s}
+ \|\mathbf{u}\|_{H^s}\|\nabla \mathbf{u}\|_{L^\infty}.
\]

\paragraph{Result.}
\begin{equation}
\frac{d}{dt}\|\mathbf{u}\|_{H^s}^2 + 2\nu \|\nabla \mathbf{u}\|_{H^s}^2
\leq C \|\nabla \mathbf{u}\|_{L^\infty}\|\mathbf{u}\|_{H^s}^2.
\label{eq:Hs-energy}
\end{equation}

\subsection{Summary}
\begin{itemize}
    \item Equation \eqref{eq:L2-energy}: global $L^2$ energy bound (always finite, always decaying).
    \item Equation \eqref{eq:enstrophy}: vorticity growth tied to $\|\nabla \mathbf{u}\|_{L^\infty}$.
    \item Equation \eqref{eq:Hs-energy}: higher-order norms controlled by $\|\nabla \mathbf{u}\|_{L^\infty}$.
\end{itemize}

The key to global smoothness is therefore bounding $\|\nabla \mathbf{u}\|_{L^\infty}$ (equivalently $\|\omega\|_{L^\infty}$), addressed in the next section via the Beale–Kato–Majda criterion and frequency-localized analysis.
