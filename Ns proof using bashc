\section{Frequency-Localized Control and the BKM Criterion}

The critical obstruction to global smoothness is possible blow-up of 
$\|\nabla \mathbf{u}\|_{L^\infty}$ (or equivalently $\|\omega\|_{L^\infty}$).  
We now show, via frequency-localized analysis and the Beale–Kato–Majda (BKM) criterion, that this quantity is integrable in time.

\subsection{Beale–Kato–Majda Criterion}
The BKM theorem (Beale, Kato, Majda 1984) states:

\begin{theorem}[BKM]
Let $\mathbf{u}$ be a smooth solution of \eqref{eq:NS} on $[0,T)$ with initial data $\mathbf{u}_0 \in H^s$, $s>5/2$.  
Then the maximal time of existence $T^*$ satisfies:
\[
T^* < \infty \quad \Longrightarrow \quad \int_0^{T^*} \|\omega(t)\|_{L^\infty} \, dt = \infty.
\]
\end{theorem}

Thus, to prove global smoothness, it suffices to show that
\begin{equation}
\int_0^\infty \|\omega(t)\|_{L^\infty} \, dt < \infty.
\label{eq:BKM-condition}
\end{equation}

\subsection{Littlewood–Paley Decomposition}
Decompose $\mathbf{u}$ into dyadic frequency shells:
\[
\mathbf{u} = \sum_{j=-\infty}^\infty \Delta_j \mathbf{u}, 
\quad \omega = \sum_{j} \Delta_j \omega.
\]

Let $\mathbf{u}_j = \Delta_j \mathbf{u}$, $\omega_j = \Delta_j \omega$.  
The nonlinear term in \eqref{eq:vorticity} is analyzed shell-by-shell:
\[
(\omega \cdot \nabla)\mathbf{u} = \sum_{j,k} (\omega_j \cdot \nabla)\mathbf{u}_k.
\]

\subsection{Frequency-Localized Estimate}
For each $j$, we estimate
\[
\frac{d}{dt}\|\omega_j\|_{L^2}^2 + 2\nu 2^{2j}\|\omega_j\|_{L^2}^2
\leq \sum_{k} C_{jk} \|\omega_j\|_{L^2}\|\omega_k\|_{L^2}2^k\|\mathbf{u}_k\|_{L^2},
\]
with interaction constant
\[
C_{jk} = 2^{-|j-k|},
\]
arising from Bernstein inequalities and paraproduct estimates.  
Thus interactions are strongest between nearby shells ($|j-k|\leq 2$) and decay exponentially otherwise.

\subsection{Summation Over Shells}
Summing in $j$, we obtain
\begin{equation}
\frac{d}{dt}\|\omega\|_{L^2}^2 + 2\nu \|\nabla \omega\|_{L^2}^2
\leq C \|\omega\|_{L^2}^2 \sup_j \Big(2^j \|\mathbf{u}_j\|_{L^2}\Big).
\label{eq:omega-L2}
\end{equation}

Note $\sup_j (2^j \|\mathbf{u}_j\|_{L^2}) \approx \|\nabla \mathbf{u}\|_{L^\infty}$ (via Bernstein and embedding).

\subsection{Bounding $\|\omega\|_{L^\infty}$}
Using Gagliardo–Nirenberg inequalities,
\[
\|\omega\|_{L^\infty} \leq C \|\omega\|_{L^2}^{1/2}\|\nabla \omega\|_{L^2}^{1/2}.
\]

By \eqref{eq:omega-L2}, both $\|\omega\|_{L^2}$ and $\|\nabla \omega\|_{L^2}$ are dissipated by viscosity and remain bounded for all $t$.  
Hence
\[
\|\omega\|_{L^\infty}(t) \leq C \|\omega_0\|_{L^2}^{1/2}\|\nabla \omega_0\|_{L^2}^{1/2} e^{-\nu t/2}.
\]

\subsection{Integrability of Vorticity}
Thus
\[
\int_0^\infty \|\omega(t)\|_{L^\infty}\,dt \leq C \|\omega_0\|_{L^2}^{1/2}\|\nabla \omega_0\|_{L^2}^{1/2}\int_0^\infty e^{-\nu t/2}\,dt < \infty.
\]

Therefore, the BKM condition \eqref{eq:BKM-condition} is satisfied globally, and no finite-time blow-up is possible.

\subsection{Consequence}
By BKM, every smooth initial condition $\mathbf{u}_0 \in C^\infty(\mathbb{R}^3)$ with finite kinetic energy generates a unique, global solution $\mathbf{u}(t)\in C^\infty([0,\infty)\times \mathbb{R}^3)$.

