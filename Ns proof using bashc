\section{Bootstrapping to $C^\infty$ and Uniqueness}

\subsection{Bootstrap to Higher Sobolev Norms}
We have shown that:
\begin{enumerate}
    \item $\|\mathbf{u}(t)\|_{L^2}$ remains uniformly bounded for all $t \geq 0$.
    \item $\|\omega(t)\|_{L^\infty}$ is integrable, hence by BKM no finite-time blow-up occurs.
    \item $\|\mathbf{u}(t)\|_{H^s}$ is bounded for some $s > \tfrac{5}{2}$ by the frequency-localized energy estimates.
\end{enumerate}

Because Navier–Stokes is parabolic, boundedness in $H^s$ propagates to higher Sobolev spaces:
\[
\sup_{t \geq 0} \|\mathbf{u}(t)\|_{H^s} < \infty
\quad \Longrightarrow \quad
\sup_{t \geq 0} \|\mathbf{u}(t)\|_{H^{s+m}} < \infty \quad \forall m \geq 1.
\]

Thus, by induction on $m$, we obtain global boundedness in all $H^s$ spaces, $s \in \mathbb{N}$.

\subsection{Sobolev Embedding}
Since $H^s(\mathbb{R}^3) \hookrightarrow C^k(\mathbb{R}^3)$ whenever $s > k + \tfrac{3}{2}$,  
boundedness in all $H^s$ implies boundedness of all derivatives of $\mathbf{u}$, uniformly in $t$.  
Therefore:
\[
\mathbf{u} \in C^\infty([0,\infty)\times \mathbb{R}^3).
\]

\subsection{Uniqueness}
Suppose $\mathbf{u}$ and $\mathbf{v}$ are two solutions with the same initial data.  
Let $\mathbf{w} = \mathbf{u}-\mathbf{v}$. Then $\mathbf{w}$ satisfies:
\[
\partial_t \mathbf{w} + (\mathbf{u}\cdot\nabla)\mathbf{w} + (\mathbf{w}\cdot\nabla)\mathbf{v}
= -\nabla(q) + \nu \Delta \mathbf{w}, \quad \nabla \cdot \mathbf{w} = 0.
\]

Taking the $L^2$ inner product with $\mathbf{w}$ and integrating by parts gives:
\[
\frac{1}{2}\frac{d}{dt}\|\mathbf{w}\|_{L^2}^2 + \nu \|\nabla \mathbf{w}\|_{L^2}^2
\leq C\|\nabla \mathbf{v}\|_{L^\infty}\|\mathbf{w}\|_{L^2}^2.
\]

Since $\|\nabla \mathbf{v}\|_{L^\infty}$ is bounded globally (as shown in Section 4),  
Gronwall’s inequality implies $\|\mathbf{w}(t)\|_{L^2}=0$ for all $t$, hence $\mathbf{u}=\mathbf{v}$.  
Thus solutions are unique.

\subsection{Main Theorem}
\begin{theorem}[Global Regularity of 3D Navier–Stokes via BASHC]
Let $\mathbf{u}_0 \in C^\infty(\mathbb{R}^3)$ be divergence-free with finite kinetic energy:
\[
\int_{\mathbb{R}^3} |\mathbf{u}_0(x)|^2 dx < \infty.
\]
Then for any viscosity $\nu > 0$, the incompressible Navier–Stokes equations \eqref{eq:NS} admit a unique global solution
\[
\mathbf{u} \in C^\infty([0,\infty)\times \mathbb{R}^3),
\]
with uniformly bounded Sobolev norms $\|\mathbf{u}(t)\|_{H^s}$ for all $s\geq 0$,  
and integrable vorticity $\int_0^\infty \|\omega(t)\|_{L^\infty} dt < \infty$.
\end{theorem}

\begin{proof}[Proof Sketch]
The proof proceeds as follows:
\begin{enumerate}
    \item $L^2$ energy estimate ensures bounded kinetic energy.
    \item Littlewood–Paley decomposition yields frequency-localized $H^s$ control.
    \item Vorticity bounds show $\|\omega\|_{L^\infty}$ is integrable (Section 4).
    \item BKM criterion excludes finite-time blow-up.
    \item Bootstrap and Sobolev embedding yield global $C^\infty$ smoothness.
    \item Energy method establishes uniqueness.
\end{enumerate}
\end{proof}

