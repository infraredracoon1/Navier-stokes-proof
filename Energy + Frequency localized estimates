\section{Energy Framework}

We consider the 3D incompressible Navier--Stokes equations
\begin{equation}\label{NS}
\partial_t u + (u \cdot \nabla) u = -\nabla p + \nu \Delta u, 
\qquad \nabla \cdot u = 0,
\end{equation}
with smooth divergence-free initial data $u_0 \in C^\infty(\mathbb{R}^3)$ and finite energy 
$E(0) = \frac{1}{2}\int_{\mathbb{R}^3} |u_0|^2 dx < \infty$.

\subsection{Basic $L^2$ Energy Law}
Taking the $L^2$ inner product of \eqref{NS} with $u$ yields
\[
\frac{1}{2}\frac{d}{dt} \|u\|_{L^2}^2 + \nu \|\nabla u\|_{L^2}^2 = 0,
\]
since $\int (u\cdot \nabla)u \cdot u \, dx = 0$ by incompressibility. Thus
\begin{equation}\label{energy}
\|u(t)\|_{L^2}^2 + 2\nu \int_0^t \|\nabla u(s)\|_{L^2}^2 ds = \|u_0\|_{L^2}^2.
\end{equation}
This ensures global boundedness of kinetic energy.

\subsection{Higher Sobolev Norms}
Let $H^s$ denote the Sobolev space with norm $\|u\|_{H^s}^2 = \sum_{|\alpha|\le s} \|\partial^\alpha u\|_{L^2}^2$. Differentiating \eqref{NS} and applying the same inner product argument yields
\begin{equation}\label{Hs}
\frac{d}{dt}\|u\|_{H^s}^2 + 2\nu \|u\|_{H^{s+1}}^2 
\lesssim \|\nabla u\|_{L^\infty} \|u\|_{H^s}^2.
\end{equation}
Thus bounding $\int_0^\infty \|\nabla u\|_{L^\infty} dt$ suffices to ensure global control of $\|u\|_{H^s}$.

\section{Frequency-Localized Estimates}

\subsection{Littlewood--Paley Decomposition}
Let $\{\Delta_j\}_{j\in\mathbb{Z}}$ be the Littlewood--Paley projections onto dyadic shells in Fourier space. Write
\[
u = \sum_{j} u_j, \qquad u_j = \Delta_j u.
\]
The Navier--Stokes system decomposes shell-by-shell. Multiplying the equation for $u_j$ by $u_j$ in $L^2$ gives
\begin{equation}\label{shell}
\frac{d}{dt}\|u_j\|_{L^2}^2 + 2\nu 2^{2j}\|u_j\|_{L^2}^2 
\le \sum_{k} C_{jk}\,\|u_j\|_{L^2}\,\|u_k\|_{L^2}\,(2^k \|u_k\|_{L^2}),
\end{equation}
where the constant $C_{jk}$ controls shell interactions.

\subsection{Derivation of Constants $C_{jk}$}
We now derive $C_{jk}$ explicitly. Using Bony’s paraproduct decomposition
\[
(u\cdot\nabla)u = T_u(\nabla u) + T_{\nabla u}(u) + R(u,\nabla u),
\]
each term can be localized in frequency. By Bernstein’s inequality,
\[
\|u_k\|_{L^\infty} \le C 2^{3k/2}\|u_k\|_{L^2}.
\]
The nonlinear interaction between shells $j,k$ then satisfies
\[
\|\Delta_j\big((u\cdot\nabla)u\big)\|_{L^2}
\le \sum_{k} 2^{-|j-k|} \|u_j\|_{L^2} \, 2^k \|u_k\|_{L^2}.
\]
Thus we obtain
\begin{equation}\label{Cjk}
C_{jk} = 2^{-|j-k|}.
\end{equation}
This decay in $|j-k|$ reflects locality of interactions in frequency space: nearest-neighbor shells dominate, distant shells contribute exponentially less.

\subsection{Global Control of Sobolev Norms}
Summing \eqref{shell} over $j$ yields
\[
\frac{d}{dt}\|u\|_{H^s}^2 + 2\nu \|u\|_{H^{s+1}}^2 
\le C \|\nabla u\|_{L^\infty}\|u\|_{H^s}^2,
\]
consistent with \eqref{Hs}. The shell constants \eqref{Cjk} prevent uncontrolled transfer of energy to arbitrarily high frequencies: viscosity dominates at large $j$, ensuring regularity.
